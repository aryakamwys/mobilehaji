# Salin jadi `.env` (root repo) lalu isi. `.env` TIDAK di-commit (gitignored).
# Dipakai oleh docker-compose.yml untuk API container.
#   cp .env.example .env   (Windows: copy .env.example .env)

# --- WAJIB -----------------------------------------------------------
# Kunci penandatanganan JWT (minimal 32 karakter, acak).
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
# atau PowerShell: [Convert]::ToBase64String((1..64|%{Get-Random -Max 256}) -as [byte[]])
JWT_KEY=ganti-dengan-random-minimal-32-karakter-xxxxxxxxxxxx

# Password akun admin pertama (seed). Email admin: admin@haji.local
ADMIN_PASSWORD=Admin#2026

# --- OPSIONAL (ada default-nya) --------------------------------------
JWT_ISSUER=haji-service
JWT_AUDIENCE=haji-mobile
API_PORT=5038

# Server Key Midtrans SANDBOX (SB-Mid-server-...) dari dashboard.sandbox.midtrans.com
# → Settings → Access Keys. Kosong = POST /api/orders ditolak dengan
# "Layanan pembayaran sedang tidak tersedia" (aman, tanpa token pembayaran).
MIDTRANS_SERVER_KEY=
